{
  "routes": [
    {
      "route": "/daily-cashup-register.html*",
      "allowedRoles": [
        "finance",
        "directors"
      ]
    },
    {
      "route": "/meetings*",
      "allowedRoles": [
        "directors"
      ]
    },
    {
      "route": "/sh-action-centre.html*",
      "allowedRoles": [
        "directors"
      ]
    },
    {
      "route": "/flow-failure-monitoring.html*",
      "allowedRoles": [
        "directors"
      ]
    },
    {
      "route": "/directors.html*",
      "allowedRoles": [
        "directors"
      ]
    },
    {
      "route": "/directors-report.html*",
      "allowedRoles": [
        "finance",
        "directors"
      ],
      "redirect": "/retail-operations-dashboard.html",
      "statusCode": 301
    },
    {
      "route": "/retail-operations-dashboard.html*",
      "allowedRoles": [
        "finance",
        "directors"
      ]
    },
    {
      "route": "/hr.html*",
      "allowedRoles": [
        "hr",
        "directors"
      ]
    },
    {
      "route": "/employee-list.html*",
      "allowedRoles": [
        "hr",
        "directors",
        "CCTV_Operator"
      ]
    },
    {
      "route": "/accounting-and-finance.html*",
      "allowedRoles": [
        "finance",
        "directors"
      ]
    },
    {
      "route": "/review-register-compliance.html*",
      "allowedRoles": [
        "operations_director"
      ]
    },
    {
      "route": "/*",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    }
  }
}
