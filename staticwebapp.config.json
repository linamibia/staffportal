{
  "routes": [
    {
      "route": "/directors.html*",
      "allowedRoles": ["directors"]
    },
    {
      "route": "/hr.html*",
      "allowedRoles": ["hr", "directors"]
    },
    {
      "route": "/approvals.html*",
      "allowedRoles": ["approvers", "directors"]
    },
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    }
  }
}
